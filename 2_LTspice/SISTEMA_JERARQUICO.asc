TEXT -900 -200 Left 3 ;SISTEMA COMPLETO - MINIESTACION INDUSTRIAL AUTOMATIZADA
TEXT -900 -170 Left 2 ;Cada recuadro es una hoja (BLOQUE_*.asc). Los bloques se conectan por nombre de nodo: v5 = 5 V, vm = 12 V despues del diodo, 0 = tierra.
TEXT -900 -152 Left 2 ;Entradas del usuario: ein (E), gin (G, cubierta cerrada = 5 V), rin (reset); sensores: b (fototransistor), enc (encoder), tnode (NTC).
TEXT -900 -134 Left 2 ;Se simula tal cual: la fuente, los eventos (objeto, cubierta, carga extra, calor, reset) y el motor estan en esta hoja.
TEXT -916 130 Left 2 ;Entrada: fuente externa de 12 V.
TEXT -916 150 Left 2 ;D1 protege contra polaridad inversa.
TEXT -916 386 Left 2 ;E, G (cubierta) y boton de reset con su guion de eventos.
TEXT -916 640 Left 2 ;fototransistor: 2 uA sin objeto, 50 uA con objeto (0.6 a 1.1 s)
TEXT -776 880 Left 2 ;NTC 10 k (B 3950): temperatura 25 C -> 60 C entre 3.0 y 3.5 s
TEXT -336 660 Left 2 ;encoder de 20 ranuras
TEXT 1676 735 Left 2 ;motor DC 12 V (modelo supuesto): Ra 12, La 3 mH, Ke = Kt = 0.035
TEXT 1996 660 Left 2 ;w = velocidad (rad/s) como voltaje; ph = fase del disco del encoder
TEXT -900 1000 Left 2 !.include ..\3_archivos_tecnicos\modelos.inc\n.include ..\3_archivos_tecnicos\sistema.inc\n.lib NE555.sub\n.param Ke=0.035 J=1e-5 Bfr=7.2e-6\n.tran 0 4.6 0 4u startup\n.save V(v5) V(vm) V(p) V(setn) V(m) V(n) V(l) V(f) V(fn) V(vref) V(vspd) V(vctrl) V(pwm) V(dm) V(sh) V(tnode) V(tc) V(w) I(Lm) I(D1)
