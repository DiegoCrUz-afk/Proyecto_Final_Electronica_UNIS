TEXT 4308 -290 Left 3 ;BLOQUE 1 - REGULADOR DE 5 V
TEXT 5452 -290 Left 3 ;BLOQUE 2 - SENSOR OPTICO IR
TEXT 5442 554 Left 2 ;LED infrarrojo (~14 mA)
TEXT 6142 412 Left 2 ;trimpot 10k
TEXT 6352 234 Left 2 ;histeresis
TEXT 6222 164 Left 2 ;pull-up
TEXT 6784 -290 Left 3 ;BLOQUE 3 - SOBRECORRIENTE
TEXT 7674 492 Left 2 ;trimpot 10k
TEXT 8096 -290 Left 3 ;BLOQUE 4 - SOBRETEMPERATURA
TEXT 8116 174 Left 2 ;NTC 10k (externo): v5 -> tnode
TEXT 8526 236 Left 2 ;trimpot 10k
TEXT 9232 -290 Left 3 ;BLOQUE 5 - LOGICA COMBINACIONAL
TEXT 9342 720 Left 2 ;reset automatico al encender
TEXT 10002 90 Left 2 ;pestillo (74HC00): setn = 0 pone F = 1
TEXT 10002 630 Left 2 ;P' = NAND(P,P)
TEXT 10482 90 Left 2 ;decision (74HC08)
TEXT 10968 -290 Left 3 ;BLOQUE 11 - ALARMA
TEXT 11264 96 Left 2 ;buzzer activo 12 V (~30 mA)
TEXT 10978 246 Left 2 ;LED rojo (~8 mA)
TEXT 12128 -290 Left 3 ;BLOQUE 7 - SEGURIDAD, EXCITADOR Y MOSFET
TEXT 13468 -290 Left 3 ;BLOQUE 6 - GENERADOR DE PWM
TEXT 14788 -290 Left 3 ;BLOQUE 10 - AMPLIFICADOR DE ERROR (LAZO CERRADO)
TEXT 16528 -290 Left 3 ;BLOQUE 9 - REFERENCIA DE VELOCIDAD
TEXT 17660 -290 Left 3 ;BLOQUE 8 - ENCODER Y CONVERTIDOR FRECUENCIA-VOLTAJE
TEXT 17650 314 Left 2 ;LED del optointerruptor
TEXT 17780 254 Left 2 ;fototransistor
TEXT -876 -152 Left 3 ;RIEL +5 V
