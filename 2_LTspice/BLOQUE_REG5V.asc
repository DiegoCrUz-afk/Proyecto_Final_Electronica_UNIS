Version 4
SHEET 1 900 500
WIRE 0 80 96 80
WIRE 0 0 160 0
WIRE 160 0 160 32
WIRE 160 128 400 128
WIRE -16 280 320 280
FLAG 0 0 vm
FLAG 0 224 0
FLAG 0 80 bz
FLAG 400 128 v5
FLAG 240 192 0
FLAG 320 192 0
FLAG -16 280 0
IOPIN 0 0 BiDir
IOPIN 400 128 BiDir
SYMBOL res -16 -16 R0
SYMATTR InstName Rz
SYMATTR Value 510
SYMBOL zener 16 144 R180
SYMATTR InstName DZ
SYMATTR Value D1N4734
SYMBOL res -16 128 R0
SYMATTR InstName Rtr
SYMATTR Value 10
SYMBOL npn 96 32 R0
SYMATTR InstName Q1
SYMATTR Value QBD139
SYMBOL polcap 224 128 R0
SYMATTR InstName Cout
SYMATTR Value 100u
SYMBOL cap 304 128 R0
SYMATTR InstName C2
SYMATTR Value 100n
TEXT -60 -130 Left 3 ;BLOQUE 1 - REGULADOR DE 5 V
TEXT -60 -100 Left 2 ;vm (12 V despues del diodo) -> v5 (5 V). El Zener fija 5.6 V en la base de Q1 y la salida es esa tension menos 0.7 V.
TEXT -60 -82 Left 2 ;Rtr (trimpot de 100 ohm) sube la salida unas decenas de mV para llevarla a 5.0 V.
TEXT -60 300 Left 2 ;DZ = Zener 1N4734A (5.6 V, 1 W).  Q1 = BD139 con disipador: en el peor caso (13 V, 120 mA) disipa ~0.9 W.
TEXT -60 320 Left 2 ;Cout (100 uF) y C2 (100 nF) filtran la salida. La resistencia Rz (510 ohm) deja ~9 mA en el Zener.
