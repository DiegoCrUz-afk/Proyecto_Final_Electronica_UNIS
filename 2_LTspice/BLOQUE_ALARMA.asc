Version 4
SHEET 1 800 500
WIRE -96 192 144 192
WIRE -96 192 -88 192
WIRE 144 144 144 192
WIRE -80 112 -80 192
FLAG 0 96 f
FLAG 144 -32 vm
FLAG -80 -32 f
FLAG -96 192 0
IOPIN 0 96 BiDir
IOPIN 144 -32 BiDir
SYMBOL res 96 80 R90
SYMATTR InstName Rb
SYMATTR Value 1k
SYMBOL npn 80 48 R0
SYMATTR InstName Q6
SYMATTR Value Q2N3904
SYMBOL res 128 -48 R0
SYMATTR InstName Rbz
SYMATTR Value 400
SYMBOL res -96 -48 R0
SYMATTR InstName Rl
SYMATTR Value 470
SYMBOL LED -96 48 R0
SYMATTR InstName Dl
SYMATTR Value DLED
TEXT -120 -110 Left 3 ;BLOQUE 11 - ALARMA
TEXT -120 -80 Left 2 ;Cuando f = 1 (falla enclavada), Q6 conduce como interruptor y enciende el buzzer de 12 V
TEXT -120 -62 Left 2 ;(en la simulacion el buzzer se representa con Rbz de 400 ohm). El LED indica la falla con luz.
TEXT 176 0 Left 2 ;buzzer activo 12 V (~30 mA)
TEXT -110 150 Left 2 ;LED rojo (~8 mA)
TEXT -120 220 Left 2 ;Ib = (4.9 - 0.7 V) / 1k = 4 mA.  Ic = 30 mA.  Ic/Ib = 7.5, menor que hFE: el transistor trabaja saturado, como interruptor.
