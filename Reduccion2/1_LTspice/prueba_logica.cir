* Reduccion 2 - prueba de la logica (E,G,P,F -> M,N,L) y del pestillo; generado por scripts/gen_logica.py
.include modelos.inc
.include sistema.inc
.include reduccion2.inc
Vcc v5 0 PWL(0 0 1m 5)
* P = salida del sensor (0 sin objeto, 5 V con objeto)
Vp p 0 PWL(0.000000 0 0.150000 0 0.150010 0 0.170000 0 0.170010 5 0.190000 5 0.190010 0 0.210000 0 0.210010 5 0.230000 5 0.230010 0 0.250000 0 0.250010 5 0.270000 5 0.270010 0 0.290000 0 0.290010 5 0.310000 5 0.310010 0 0.350000 0 0.350010 0 0.370000 0 0.370010 5 0.390000 5 0.390010 0 0.410000 0 0.410010 5 0.430000 5 0.430010 0 0.450000 0 0.450010 5 0.470000 5 0.470010 0 0.490000 0 0.490010 5 0.510000 5 0.510010 0)
* Toggle E y micro-switch G: 5 V -> entrada (control 1 = cerrado)
Ve ce 0 PWL(0.000000 0 0.150000 0 0.150010 0 0.170000 0 0.170010 0 0.190000 0 0.190010 0 0.210000 0 0.210010 0 0.230000 0 0.230010 1 0.250000 1 0.250010 1 0.270000 1 0.270010 1 0.290000 1 0.290010 1 0.310000 1 0.310010 1 0.350000 1 0.350010 0 0.370000 0 0.370010 0 0.390000 0 0.390010 0 0.410000 0 0.410010 0 0.430000 0 0.430010 1 0.450000 1 0.450010 1 0.470000 1 0.470010 1 0.490000 1 0.490010 1 0.510000 1 0.510010 1)
Vg cg 0 PWL(0.000000 0 0.150000 0 0.150010 0 0.170000 0 0.170010 0 0.190000 0 0.190010 1 0.210000 1 0.210010 1 0.230000 1 0.230010 0 0.250000 0 0.250010 0 0.270000 0 0.270010 1 0.290000 1 0.290010 1 0.310000 1 0.310010 1 0.350000 1 0.350010 0 0.370000 0 0.370010 0 0.390000 0 0.390010 1 0.410000 1 0.410010 1 0.430000 1 0.430010 0 0.450000 0 0.450010 0 0.470000 0 0.470010 1 0.490000 1 0.490010 1 0.510000 1 0.510010 1)
Vs cs 0 PWL(0.000000 0 0.310000 0 0.310010 1 0.330000 1 0.330010 0 0.510000 0 0.510010 1 0.560000 1 0.560010 0)
Vr cr 0 PWL(0.000000 0 0.520000 0 0.520010 1 0.540000 1 0.540010 0 0.600000 0 0.600010 1 0.620000 1 0.620010 0)
.model SWB SW(Ron=0.1 Roff=1G Vt=0.5 Vh=0.1)
Se v5 ein ce 0 SWB
Sg v5 gin cg 0 SWB
Sr v5 rin cr 0 SWB
* Pulsador FALLA: setn a GND (10k a 5 V ya esta dentro de LOGICA)
Sf setn 0 cs 0 SWB
XL v5 ein gin rin p setn m n l f fn LOGICA_R2
.tran 0 0.670 0 10u
.options plotwinsize=0
.meas tran m_A_000 find V(m) at=0.1680
