.meas tran m_t_cubierta find V(m) at=2.38
.meas tran n_t_cubierta find V(n) at=2.38
.meas tran f_t_cubierta find V(f) at=2.38
.meas tran p_t_cubierta find V(p) at=2.38
.meas tran lo_t_cubierta find V(LOG_lo) at=2.38
.meas tran led_t_cubierta find V(ALA_nl) at=2.38
.meas tran dm_t_cubierta find V(dm) at=2.38
.meas tran w_t_falla find V(w) at=3.1
.meas tran m_t_falla find V(m) at=3.1
.meas tran n_t_falla find V(n) at=3.1
.meas tran f_t_falla find V(f) at=3.1
.meas tran p_t_falla find V(p) at=3.1
.meas tran lo_t_falla find V(LOG_lo) at=3.1
.meas tran led_t_falla find V(ALA_nl) at=3.1
.meas tran dm_t_falla find V(dm) at=3.1
.meas tran w_t_reset find V(w) at=4
.meas tran m_t_reset find V(m) at=4
.meas tran n_t_reset find V(n) at=4
.meas tran f_t_reset find V(f) at=4
.meas tran p_t_reset find V(p) at=4
.meas tran lo_t_reset find V(LOG_lo) at=4
.meas tran led_t_reset find V(ALA_nl) at=4
.meas tran dm_t_reset find V(dm) at=4
.save V(w) V(m) V(n) V(f) V(p) V(LOG_lo) V(ALA_nl) V(dm)
