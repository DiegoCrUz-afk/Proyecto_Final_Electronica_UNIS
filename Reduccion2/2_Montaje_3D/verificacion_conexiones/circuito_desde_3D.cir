.meas tran f_t_normal2 find V(f) at=2.1
.meas tran p_t_normal2 find V(p) at=2.1
.meas tran lo_t_normal2 find V(LOG_lo) at=2.1
.meas tran led_t_normal2 find V(ALA_nl) at=2.1
